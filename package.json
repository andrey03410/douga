{
  "name": "douga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "prisma db push && prisma generate",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "visual:render": "tsx --env-file-if-exists=.env --tsconfig tsconfig.mcp.json scripts/visual-regression.ts render",
    "visual:check": "tsx --env-file-if-exists=.env --tsconfig tsconfig.mcp.json scripts/visual-regression.ts check",
    "visual:accept": "tsx --env-file-if-exists=.env --tsconfig tsconfig.mcp.json scripts/visual-regression.ts accept",
    "test:visual": "npm run visual:render && npm run visual:check",
    "studio:worker": "tsx --env-file-if-exists=.env --tsconfig tsconfig.mcp.json scripts/studio-worker.ts",
    "mcp": "tsx --env-file-if-exists=.env --tsconfig tsconfig.mcp.json src/mcp/server.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/driver-adapter-utils": "7.10.1",
    "@remotion/bundler": "^4.0.230",
    "@remotion/cli": "^4.0.230",
    "@remotion/player": "^4.0.230",
    "@remotion/renderer": "^4.0.230",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "esbuild": "0.28.0",
    "ffmpeg-static": "^5.2.0",
    "fontkit": "2.0.4",
    "music-metadata": "^7.14.0",
    "next": "^14.2.35",
    "next-auth": "5.0.0-beta.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "^4.0.230",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/fontkit": "2.0.9",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prisma": "7.10.1",
    "puppeteer-core": "^25.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
