// Prisma schema — Douga
// MVP uses SQLite for zero-dependency local runs. Production target is Postgres:
// switch `provider` to "postgresql" and set DATABASE_URL accordingly — the models
// below are provider-agnostic.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  // Role name; permissions/quotas resolve through the matrix in
  // src/lib/domain/permissions.ts. Read fresh from the DB on every request
  // (never trusted from the JWT) so role changes apply without re-login.
  role         String       @default("user")
  createdAt    DateTime     @default(now())
  tournaments  Tournament[]
  arts         Art[]
  projects     VideoProject[]
  studioProjects StudioProject[]
  studioPresets StudioPreset[]
  studioMutations StudioMutation[]
  studioJobs StudioJob[]
  studioPublications StudioPublication[]
  studioExportCaches StudioExportCache[]
}

// ---- Phase 1: tournament ----
// SQLite has no native enums; enum-like fields are stored as strings and validated
// in the app layer (see src/lib/domain/types.ts).

model Tournament {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  scheme    String // "merge" | "swiss" | "round_robin"
  blindMode Boolean  @default(false)
  status    String   @default("draft") // "draft" | "in_progress" | "completed"
  topSize   Int?
  // Phase 18: how many tracks one comparison screen ranks at once (2 = pairs).
  groupSize Int      @default(2)
  // Opponents per track bought beyond the plan via "one more round". Stored in
  // opponents, not rounds, so changing groupSize does not move what was bought.
  bonusOpponents Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studioReferences StudioAssetReference[]
  tracks       Track[]
  comparisons  Comparison[]
  batches      ComparisonBatch[]
  rankings     Ranking[]
  renderConfig RenderConfig?
  renderJobs   RenderJob[]
}

model Track {
  id           String  @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  title        String
  artist       String?
  filePath     String
  durationSec  Float?
  order        Int
  kind         String  @default("audio") // "audio" | "video"
  // File size on disk. Float (not Int) because files may exceed 2^31 bytes.
  // Nullable: rows created before phase 5 are backfilled lazily via stat().
  sizeBytes    Float?

  studioReferences StudioAssetReference[]
  renderItems RenderItem[]
}

// Phase 18: one comparison screen. A group ranking lands as C(k,2) rows, and
// they have to travel together — undo removes a whole screen, progress counts
// screens, and resuming has to know what was actually shown when the user was
// free to change the group size mid-run.
model ComparisonBatch {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  size         Int // tracks shown on the screen
  itemIds      String // JSON array of the shown track ids, in the order shown
  createdAt    DateTime @default(now())

  comparisons  Comparison[]
}

model Comparison {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  trackAId     String
  trackBId     String
  result       String // "a" | "b" | "draw"
  createdAt    DateTime @default(now())
  // null on rows written before phase 18 (one pair per screen back then).
  batchId      String?
  batch        ComparisonBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Ranking {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  trackId      String
  rank         Int
  score        Float

  @@unique([tournamentId, trackId])
}

// ---- Phase 6: standalone video projects (manual top / picker) ----

model VideoProject {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String
  kind   String // "top" | "picker"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Picker defaults; rounds inherit unless they override.
  revealSec       Float   @default(4)
  hideAfterReveal Boolean @default(false)
  timerSec        Float   @default(5)
  tickSound       Boolean @default(true)
  bgArtId         String?
  bgArt           Art?    @relation("ProjectBg", fields: [bgArtId], references: [id], onDelete: SetNull)
  bgMusicArtId    String?
  bgMusicArt      Art?    @relation("ProjectBgMusic", fields: [bgMusicArtId], references: [id], onDelete: SetNull)
  // "landscape" | "portrait" — default tile orientation; rounds inherit unless overridden.
  tileOrientation String  @default("landscape")

  // Picker bookends (title/final cards, same idea as RenderConfig.intro*/outro*
  // for tops). Off by default so existing pickers keep their exact timeline;
  // freshly created pickers get them switched on with texts.
  introEnabled Boolean @default(false)
  introText    String?
  outroEnabled Boolean @default(false)
  outroText    String?

  rounds       PickerRound[]
  playlist     PickerPlaylistItem[]
  renderConfig RenderConfig?
  renderJobs   RenderJob[]
}

// Ordered background-music playlist of a picker project: plays through the
// whole video with crossfades, looping when exhausted. Rounds with their own
// bgMusicArtId mute it for their duration (the timeline keeps running).
model PickerPlaylistItem {
  id        String       @id @default(cuid())
  projectId String
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int
  artId     String
  art       Art          @relation("PlaylistArt", fields: [artId], references: [id], onDelete: Cascade)
}

model PickerRound {
  id        String       @id @default(cuid())
  projectId String
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int
  prompt     String?
  showPrompt Boolean @default(true)
  // "always" | "finale" | "never" — when tile labels are visible.
  labelsMode String  @default("finale")
  // Null = inherit the project default.
  revealSec       Float?
  hideAfterReveal Boolean?
  timerSec        Float?
  bgArtId      String?
  bgArt        Art?    @relation("RoundBg", fields: [bgArtId], references: [id], onDelete: SetNull)
  bgMusicArtId String?
  bgMusicArt   Art?    @relation("RoundBgMusic", fields: [bgMusicArtId], references: [id], onDelete: SetNull)
  // "landscape" | "portrait" override, or null = inherit the project default.
  tileOrientation String?
  // "single" (2-9 standalone tiles) | "groups" (block against block, spec 16).
  mode String @default("single")

  tiles  PickerTile[]
  groups PickerGroup[]
}

// A block of a group-comparison round: 1-5 cards, up to 3 blocks per round.
model PickerGroup {
  id       String      @id @default(cuid())
  roundId  String
  round    PickerRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  order    Int
  // null = the frame shows the positional name («Блок А/Б/В»).
  label    String?
  // The winning block of the round; at most one per round, and optional.
  isAnswer Boolean     @default(false)

  tiles PickerTile[]
}

model PickerTile {
  id      String      @id @default(cuid())
  roundId String
  round   PickerRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  // Set in group rounds: which block the card belongs to (null in single mode).
  groupId String?
  group   PickerGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  order   Int
  artId   String
  art     Art    @relation(fields: [artId], references: [id], onDelete: Cascade)
  label     String?
  isAnswer  Boolean @default(false)
  // Play the tile video's own sound during its reveal window (video with audio only).
  playSound Boolean @default(true)
  // "cover" | "fill" | "contain" — how the art fills the tile rect.
  fitMode   String  @default("cover")
  // Footage start offset for video tiles.
  startSec  Float?
  // Non-destructive 16:9 crop, same semantics as RenderItem.artCrop*.
  cropX Float?
  cropY Float?
  cropW Float?
  cropH Float?
}

// ---- Phase 2: render ----

// Pool media: images, videos and (phase 6) audio. Kept named "Art" for
// compatibility; kind distinguishes them.
model Art {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  filePath String
  label    String?
  kind     String  @default("image") // "image" | "video" | "audio"
  // Video-only metadata (probed at upload).
  durationSec Float?
  hasAudio    Boolean @default(false)
  posterPath  String? // extracted first frame (jpg) for grid cards / thumbs
  // File size on disk (see Track.sizeBytes); drives the pool quota check.
  sizeBytes   Float?
  createdAt DateTime @default(now())
  // Set when the art is assigned to a render item; drives the "recent" picker block.
  lastUsedAt DateTime?

  studioReferences StudioAssetReference[]
  renderItems      RenderItem[]
  audioRenderItems RenderItem[]   @relation("RenderItemAudio")
  pickerTiles      PickerTile[]
  projectBgs       VideoProject[] @relation("ProjectBg")
  projectMusics    VideoProject[] @relation("ProjectBgMusic")
  roundBgs         PickerRound[]  @relation("RoundBg")
  roundMusics      PickerRound[]  @relation("RoundBgMusic")
  playlistItems    PickerPlaylistItem[] @relation("PlaylistArt")
}

model RenderConfig {
  id             String   @id @default(cuid())
  // Exactly one owner: a tournament OR a standalone "top" project (validated
  // in the service layer; SQLite has no check constraints via Prisma).
  tournamentId   String?  @unique
  tournament     Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  projectId      String?  @unique
  project        VideoProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orientation    String   @default("16x9")
  order          String   @default("desc") // "desc" (N->1) | "asc" (1->N)
  template       String   @default("default")
  defaultClipSec Float    @default(30)
  introEnabled   Boolean  @default(true)
  introText      String?
  outroEnabled   Boolean  @default(true)
  outroText      String?
  updatedAt      DateTime @updatedAt

  items RenderItem[]
}

model RenderItem {
  id             String  @id @default(cuid())
  renderConfigId String
  renderConfig   RenderConfig @relation(fields: [renderConfigId], references: [id], onDelete: Cascade)
  // Audio source of the position: a tournament track (tournament tops) OR a
  // pool audio/sounded-video (manual tops). Exactly one is set.
  trackId        String?
  track          Track?  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  audioArtId     String?
  audioArt       Art?    @relation("RenderItemAudio", fields: [audioArtId], references: [id], onDelete: Cascade)
  rank           Int
  artId          String?
  art            Art?    @relation(fields: [artId], references: [id], onDelete: SetNull)
  clipMode       String  @default("active_snippet") // "manual" | "active_snippet" | "full"
  clipStartSec   Float?
  clipEndSec     Float?
  snippetLenSec  Float?
  // Cached active-snippet start (sec), computed via RMS analysis. null = needs (re)compute.
  resolvedStartSec Float?
  customLabel    String?
  // Non-destructive per-position crop: normalized rect (0..1 fractions of the source
  // image) with a 16:9 aspect in source pixels. All four set, or all null (= auto cover).
  artCropX Float?
  artCropY Float?
  artCropW Float?
  artCropH Float?
  // Audio source: "track" (default) or "media" (the attached pool video's own audio;
  // valid only when the attached media is a video with an audio stream).
  audioSource String @default("track")
  // When the attached video is visual-only (audioSource = "track"): footage start
  // offset in seconds. null = 0.
  mediaStartSec Float?

  @@unique([renderConfigId, trackId])
}

// Background URL-import job (yt-dlp): downloads a video/audio into the pool.
model DownloadJob {
  id       String @id @default(cuid())
  userId   String
  url      String
  mode     String @default("video") // "video" | "audio"
  quality  Int    @default(1080)    // max height for video mode
  title    String?
  status   String @default("queued") // "queued" | "running" | "done" | "failed" | "canceled"
  progress Float  @default(0)
  error    String?
  // Filled on success: the pool media created from the download.
  artId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RenderJob {
  id             String   @id @default(cuid())
  // Exactly one owner: tournament or project (service-validated).
  tournamentId   String?
  tournament     Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  projectId      String?
  project        VideoProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status         String   @default("queued") // "queued" | "running" | "done" | "failed"
  progress       Float    @default(0)
  outputPath     String?
  // Size of the finished MP4; the cabinet sums these instead of stat()-ing every
  // file on each page load. null = never measured (lazily backfilled).
  outputBytes    Float?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Studio v1: additive, independent of legacy VideoProject.
model StudioProject {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  title String
  kind String
  version Int @default(1)
  revision Int @default(1)
  documentJson String
  draftText String?
  draftValidationJson String?
  sourceVersion String?
  lastGoodRevision Int?
  previewJson String?
  previewVersion Int?
  previewRevision Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions StudioRevision[]
  references StudioAssetReference[]
  snapshots StudioSnapshot[]
  jobs StudioJob[]
  publications StudioPublication[]
  exportCaches StudioExportCache[]
}
model StudioRevision {
  id String @id @default(cuid())
  projectId String
  project StudioProject @relation(fields:[projectId],references:[id],onDelete:Cascade)
  revision Int
  reason String
  documentJson String
  sourceVersion String?
  validationJson String
  planJson String?
  assetsJson String?
  createdAt DateTime @default(now())
  snapshots StudioSnapshot[]
  @@unique([projectId,revision])
}
model StudioAssetReference {
  id String @id @default(cuid())
  projectId String
  project StudioProject @relation(fields:[projectId],references:[id],onDelete:Cascade)
  // head, draft, revision:<number>; frozen data keeps its revision referenced.
  scope String
  artId String?
  art Art? @relation(fields:[artId],references:[id],onDelete:Restrict)
  trackId String?
  track Track? @relation(fields:[trackId],references:[id],onDelete:Restrict)
  tournamentId String?
  tournament Tournament? @relation(fields:[tournamentId],references:[id],onDelete:Restrict)
  @@index([projectId,scope])
  @@index([artId])
  @@index([tournamentId])
}
model StudioSnapshot {
  id String @id @default(cuid())
  projectId String
  project StudioProject @relation(fields:[projectId],references:[id],onDelete:Cascade)
  revisionId String
  revision StudioRevision @relation(fields:[revisionId],references:[id],onDelete:Restrict)
  payloadJson String
  jobs StudioJob[]
  publications StudioPublication[]
  bytes Float
  createdAt DateTime @default(now())
}
/// One public link per studio project. The token is the capability.
/// Restrict on every FK: callers delete the row before the snapshot or the project.
model StudioPublication {
  id String @id @default(cuid())
  projectId String @unique
  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  token String @unique
  snapshotId String
  snapshot StudioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  revision Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@index([snapshotId])
}
/// Sliced media kept so a repeat HTML download does not re-encode. Disposable.
model StudioExportCache {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key String @unique
  bytes Float
  relativePath String
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([projectId])
}
model StudioPreset {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  presetJson String
  createdAt DateTime @default(now())
}
model StudioMutation {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  key String
  requestHash String
  resultJson String
  createdAt DateTime @default(now())
  @@unique([userId,key])
}
model StudioAnalysis {
  key String @id
  startSec Float
  endSec Float
}

// Shared durable queue: imports may have no project/snapshot; composition jobs require both.
model StudioJob {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  projectId String?
  project StudioProject? @relation(fields:[projectId],references:[id],onDelete:Restrict)
  snapshotId String?
  snapshot StudioSnapshot? @relation(fields:[snapshotId],references:[id],onDelete:Restrict)
  kind String
  inputJson String
  engineId String
  status String @default("queued")
  progress Float @default(0)
  attempts Int @default(0)
  workerId String?
  leaseToken String?
  leaseUntil DateTime?
  availableAt DateTime @default(now())
  error String?
  resultJson String?
  outputBytes Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,availableAt])
  @@index([userId,status])
}
// One persisted heavy-work slot. A lease token fences every attempt's writes.
model StudioWorkerLease {
  id String @id
  token String?
  until DateTime?
}
