DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST="true"
# Браузер для РЕНДЕРА видео (Remotion). Укажите путь к установленному
# Chrome/Chromium: macOS — "/Applications/Google Chrome.app/Contents/MacOS/Google
# Chrome", Linux — /usr/bin/google-chrome.
# Если не задать, Remotion попытается СКАЧАТЬ chrome-headless-shell из сети —
# в оффлайне рендер упадёт ("could not download browser"). Скачать заранее:
#   npx remotion browser ensure
# Без браузера работает всё, кроме кнопки «Рендерить видео».
REMOTION_BROWSER_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Emails auto-elevated to the admin role on login/registration (comma-separated).
ADMIN_EMAILS="you@example.com"

# Путь к бинарнику yt-dlp для импорта по ссылке. Если не задан, приложение
# само скачает свежий официальный релиз с github.com/yt-dlp/yt-dlp в
# storage/bin при первом использовании (системный yt-dlp часто слишком стар
# для текущего YouTube).
# YTDLP_PATH="/opt/homebrew/bin/yt-dlp"

# Прокси для скачивания по ссылке (yt-dlp --proxy): нужен там, где видео-CDN
# YouTube (googlevideo.com) заблокирован на уровне сети — метаданные при этом
# работают, а сама загрузка падает с таймаутом. Форматы: http://host:port,
# socks5://host:port (например, локальный VPN-клиент).
# YTDLP_PROXY="socks5://127.0.0.1:1080"

# Shikimori (импорт постеров аниме/персонажей). Домен часто мигрирует
# (.one → .io → …) — при переезде поменяйте только этот URL и перезапустите.
SHIKIMORI_BASE_URL="https://shikimori.io"
# Осмысленный User-Agent требуется этикетом API Shikimori.
SHIKIMORI_USER_AGENT="douga"

# MCP-сервер (Phase 10): от имени какого аккаунта работает внешний ИИ через
# stdio MCP. Все вызовы инструментов идут с id/ролью/квотами этого
# пользователя — сначала зарегистрируйте его в приложении.
MCP_ACTOR_EMAIL="you@example.com"

# Публичный адрес сайта для ссылок HTML-плеера, которые возвращает MCP.
# Хвостовой слэш обрезается. По умолчанию http://localhost:3000.
# DOUGA_PUBLIC_URL="http://localhost:3000"

# Папки на диске, из которых MCP-инструменты могут забирать медиа в пул
# (разделитель ":", поддерживается "~/"). Пусто/не задано = доступа к диску нет.
MCP_LOCAL_MEDIA_DIRS="~/Music/ost"
